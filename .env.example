# Copiá este archivo como ".env" y completá los valores.

# Base de datos PostgreSQL (por ejemplo, la cadena de conexión que te da Neon o Supabase).
DATABASE_URL="postgresql://usuario:clave@localhost:5432/turnoclaro"

# Dirección pública del sistema, sin barra al final. Se usa en los links que reciben los pacientes.
APP_URL="http://localhost:3000"

# Permite que cualquiera cree un consultorio desde /registro (prueba gratis de 14 días).
SIGNUP_ENABLED="true"

# Clave para la tarea programada de recordatorios (/api/cron/recordatorios). Inventá una larga.
CRON_SECRET="cambiar-por-una-clave-larga"

# Clave para cifrar los tokens de WhatsApp de cada consultorio. Inventá una larga y no la cambies después.
SECRETS_KEY="cambiar-por-otra-clave-larga"

# Superadmin (vos). Lo crea "npm run db:seed".
SUPERADMIN_EMAIL="tu-email@ejemplo.com"
SUPERADMIN_PASSWORD="cambiar-esta-clave"

# --- WhatsApp Cloud API (opcional) ---------------------------------
# Si lo dejás vacío, el sistema funciona en modo manual: arma el mensaje y abre WhatsApp.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Del panel de tu app en Meta (Configuración > Básica > Clave secreta), para validar el webhook.
WHATSAPP_APP_SECRET=""
# Texto que inventás vos y cargás igual en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=""
# Nombre e idioma de la plantilla aprobada por Meta (ver README).
WHATSAPP_TEMPLATE_RECORDATORIO="recordatorio_turno"
WHATSAPP_TEMPLATE_LANG="es_AR"
