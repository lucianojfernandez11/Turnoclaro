{
  "name": "turnoclaro",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de turnos para consultorios: agenda, recordatorios por WhatsApp y reserva online.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test src/lib/__tests__/logic.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "6.16.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
